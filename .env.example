# Root Environment Contract (Section 16.3)
# Backend env template: artifacts/api-server/.env.example
# Mobile app env template: artifacts/safarsaathi/.env.example

# Backend (Render / local api-server)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safarsaathi
FIREBASE_SERVICE_ACCOUNT_JSON=
# Dev-only: set to 'true' to enable x-dev-user-id bypass header (NEVER in production)
DEV_AUTH_BYPASS=false
SERVER_BOX_SECRET_KEY=
SERVER_BOX_PUBLIC_KEY=
SMS_PROVIDER=console
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_USER=admin
SMS_GATEWAY_PASSWORD=secret
SMS_GATEWAY_PASSPHRASE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SMTP_URL=
ORS_API_KEY=
ROUTING_DAILY_LIMIT=1800
TICK_SECRET=replace_with_random_secret
PUBLIC_BASE_URL=http://localhost:3000
GUARDIAN_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
WATCHDOG_SIGNAL_LOST_SEC=180
# A missed safety check gets a second prompt after 30 seconds, then triggers SOS 10 seconds later.
WATCHDOG_FIRST_CHECK_RESPONSE_SEC=30
WATCHDOG_SECOND_CHECK_RESPONSE_SEC=10
WATCHDOG_LOST_CONTACT_SEC=300
WATCHDOG_ETA_GRACE_SEC=600
RETENTION_TRIP_POINTS_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Mobile (Expo / SafarSaathi App)
EXPO_PUBLIC_API_URL=http://127.0.0.1:4010
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_FEATURES=relay,ride,fakecall,demo


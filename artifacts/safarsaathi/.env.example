# Local Prism mock (:4010) during Phase 1-2, or Render / LAN URL for live backend
# Note: On Android physical phone over USB, use `adb reverse tcp:4010 tcp:4010`
# or your machine LAN IP (e.g., http://192.168.1.50:4010).
EXPO_PUBLIC_API_URL=http://127.0.0.1:4010

# OpenFreeMap Liberty/Bright style URL for MapLibre (no API key required)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Comma-separated feature flags (relay,ride,fakecall,demo)
EXPO_PUBLIC_FEATURES=relay,ride,fakecall,demo


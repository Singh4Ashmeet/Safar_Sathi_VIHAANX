# ==============================================================================
# SafarSaathi 2.0 API Server - Environment Variables
# All secrets and external endpoints are configured here.
# Free-stack edition: NO paid or card-gated services (No Twilio, No Google Maps).
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Database (Supabase Free PostgreSQL via IPv4 pooled connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safarsaathi

# Firebase Auth (Spark free plan - service account JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# BLE Relay Encryption (X25519 tweetnacl keypair, base64-encoded)
SERVER_BOX_SECRET_KEY=
SERVER_BOX_PUBLIC_KEY=
# Exact 8-byte destination tag for v1 relay packets, hex encoded (16 characters).
RELAY_DEST_TAG=
RELAY_MAX_AGE_SEC=86400
RELAY_FUTURE_SKEW_SEC=300

# SMS Provider ('console' for local/tests, 'android-gateway' for SMS Gateway for Android on a spare phone)
SMS_PROVIDER=console
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_USER=admin
SMS_GATEWAY_PASSWORD=secret
SMS_GATEWAY_PASSPHRASE=optional_e2ee_passphrase

# Telegram Bot (Free channel for guardian alerts and consent flow)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email (Free SMTP channel, e.g., Gmail App Password or Brevo free tier)
SMTP_URL=smtp://user:pass@smtp.example.com:587

# Routing & Geocoding (OpenRouteService free tier: 2000 directions/day, 1000 geocoding/day)
ORS_API_KEY=
ROUTING_DAILY_LIMIT=1800

# Watchdog & Internal Tick Security (Shared secret for POST /internal/tick)
TICK_SECRET=safarsaathi_dev_tick_secret_replace_in_prod

# Public URLs
PUBLIC_BASE_URL=http://localhost:3000
GUARDIAN_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Watchdog Thresholds (in seconds)
WATCHDOG_SIGNAL_LOST_SEC=180
# A missed safety check gets a second prompt after 30 seconds, then triggers SOS 10 seconds later.
WATCHDOG_FIRST_CHECK_RESPONSE_SEC=30
WATCHDOG_SECOND_CHECK_RESPONSE_SEC=10
WATCHDOG_LOST_CONTACT_SEC=300
WATCHDOG_ETA_GRACE_SEC=600

# Retention Policy (Free-tier 500 MB budget protection)
RETENTION_TRIP_POINTS_DAYS=7

